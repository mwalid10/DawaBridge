Icon?
**/Pods/
# CocoaPods is not used: every plugin resolves through Swift Package
# Manager. A committed Podfile (or lock) makes Flutter treat the project as
# non-standard and refuse to migrate, which leaves CocoaPods half-wired and
# fails the build on a sandbox/lockfile mismatch.
Podfile
Podfile.lock
**/.symlinks/
profile
xcuserdata
**/.generated/
Flutter/App.framework
Flutter/Flutter.framework
Flutter/Flutter.podspec
Flutter/Generated.xcconfig
Flutter/ephemeral/
Flutter/app.flx
Flutter/app.zip
Flutter/flutter_assets/
Flutter/flutter_export_environment.sh
ServiceDefinitions.json
Runner/GeneratedPluginRegistrant.*

